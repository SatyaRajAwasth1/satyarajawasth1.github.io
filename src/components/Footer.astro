---
import { getConfig } from '../utils/config';

const config = await getConfig();
const updated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<footer class="page foot">
  <p><em>Last updated {updated}.</em> © {new Date().getFullYear()} {config.name}.</p>
</footer>

<style>
  .foot {
    margin-top: 5rem;
    padding-bottom: 3rem;
    font-size: 0.85em;
    color: var(--ink-3);
  }
  .foot p {
    max-width: var(--text);
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
</style>
