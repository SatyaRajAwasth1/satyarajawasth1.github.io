---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'news'>[];
}
const entries = [...Astro.props.entries].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

{
  entries.map(({ data }) => (
    <div class="row entry">
      <p set:html={data.text} />
      <p class="note"><time datetime={data.date.toISOString().slice(0, 10)}>{fmt(data.date)}</time></p>
    </div>
  ))
}
