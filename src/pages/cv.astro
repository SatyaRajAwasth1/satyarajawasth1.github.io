---
import Layout from '../layouts/Layout.astro';
import { getConfig } from '../utils/config';

const config = await getConfig();
---

<Layout title={`Curriculum vitae · ${config.name}`}>
  <section class="cv">
    <h1 class="page-title">Curriculum vitae</h1>
    <p class="links"><a href={config.cv_url}>Open the PDF</a> or <a href={config.cv_url} download>download it</a>.</p>
    <object data={config.cv_url} type="application/pdf" class="frame" aria-label="Curriculum vitae (PDF)">
      <p>Your browser can't show the PDF here. <a href={config.cv_url}>Open it instead</a>.</p>
    </object>
  </section>
</Layout>

<style>
  .cv { padding-top: 2.5rem; }
  .links { color: var(--ink-2); }
  .frame { display: block; width: 100%; height: 85vh; margin-top: 1.25rem; border: 1px solid var(--rule); }
</style>
