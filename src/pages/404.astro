---
import Layout from '../layouts/Layout.astro';
import { getConfig } from '../utils/config';

const config = await getConfig();
---

<Layout title={`Page not found · ${config.name}`}>
  <section class="notfound">
    <h1 class="page-title">Page not found</h1>
    <p>The page you were looking for doesn’t exist. Go back to the <a href="/">home page</a>.</p>
  </section>
</Layout>

<style>
  .notfound { padding-top: 2.5rem; min-height: 40vh; }
</style>
